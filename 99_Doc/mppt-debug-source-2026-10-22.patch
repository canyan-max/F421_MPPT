+static void cancel_mppt_recapture(void)
+{
+    g_charge_mppt_recapture_request = 0U;
+    if(0U != g_charge_mppt_recapture_active)
+    {
+        g_charge_mppt_recapture_active = 0U;
+        g_charge_mppt_recapture.status = SVC_CHARGE_MPPT_RECAPTURE_ABORTED;
+    }
+}
+
+static void request_mppt_recapture(void)
+{
+    svc_measure_value_t         value;
+    svc_charge_mppt_recapture_t empty_result;
+    platform_err_t              status;
+    uint8_t                     request = g_charge_mppt_recapture_request;
+
+    g_charge_mppt_recapture_request = 0U;
+    if(0U != g_charge_mppt_recapture_active)
+    {
+        return;
+    }
+    if(1U != request || SVC_CHARGE_STATE_CONSTANT_CURRENT != g_charge_state ||
+       0U != g_charge_current_limited ||
+       SVC_CHARGE_FAULT_NONE != g_charge_fault ||
+       SVC_CHARGE_MPPT_PROBE_RUNNING == g_charge_mppt_probe.status)
+    {
+        g_charge_mppt_recapture.status = SVC_CHARGE_MPPT_RECAPTURE_REJECTED;
+        return;
+    }
+    status = svc_measure_get(&value);
+    if(PLATFORM_ERR_OK != status)
+    {
+        g_charge_mppt_recapture.status = SVC_CHARGE_MPPT_RECAPTURE_REJECTED;
+        return;
+    }
+    /* Clear only this result. Do not destroy either existing trace buffer. */
+    memset(&empty_result, 0, sizeof(empty_result));
+    g_charge_mppt_recapture                           = empty_result;
+    g_charge_mppt_recapture.duty_before_permille      = g_charge_duty_permille;
+    g_charge_mppt_recapture.input_voltage_before_mv   = value.input_voltage_mv;
+    g_charge_mppt_recapture.battery_voltage_before_mv = value
+                                                            .battery_voltage_mv;
+    g_charge_mppt_recapture.input_current_before_ma   = value.input_current_ma;
+    status = bsp_power_path_charge_stop();
+    if(PLATFORM_ERR_OK != status)
+    {
+        enter_fault(SVC_CHARGE_FAULT_POWER_PATH, status);
+        g_charge_mppt_recapture.fault       = g_charge_fault;
+        g_charge_mppt_recapture.state_after = g_charge_state;
+        g_charge_mppt_recapture.status      = SVC_CHARGE_MPPT_RECAPTURE_FAILED;
+        return;
+    }
+    g_charge_duty_permille = 0U;
+    svc_charge_protection_reset();
+    svc_charge_maintenance_reset();
+    reset_mppt_runtime();
+    reset_recovery_runtime();
+    g_charge_last_sequence                = svc_measure_get_sequence();
+    g_charge_stale_tick_count             = 0U;
+    g_charge_settle_tick_count            = 0U;
+    g_charge_duty_high_limited            = 0U;
+    g_charge_mppt_recapture_off_ticks     = 0U;
+    g_charge_mppt_recapture_elapsed_ticks = 0U;
+    g_charge_mppt_recapture_active        = 1U;
+    g_charge_status                       = PLATFORM_ERR_BUSY;
+    g_charge_state                 = SVC_CHARGE_STATE_MPPT_RECAPTURE_WAIT;
+    g_charge_mppt_recapture.status = SVC_CHARGE_MPPT_RECAPTURE_OFF_WAIT;
+}
+
+static void process_mppt_recapture_wait(void)
+{
+    svc_measure_value_t value;
+    platform_err_t      status;
+    svc_charge_fault_t  fault;
+    uint8_t             is_new;
+
+    status = get_new_measurement(&value, &is_new, &fault, 0U);
+    if(PLATFORM_ERR_OK != status)
+    {
+        enter_fault(fault, status);
+        return;
+    }
+    if(0U == is_new)
+    {
+        return;
+    }
+    g_charge_mppt_recapture_off_ticks++;
+    if(g_charge_mppt_recapture_off_ticks >=
+           delay_ms_to_ticks(SVC_CHARGE_MPPT_RECAPTURE_OFF_MS) &&
+       0U != svc_measure_is_ready())
+    {
+        /* All startup validation and D computation remain in WAIT_SAMPLE. */
+        return_to_wait_sample();
+        g_charge_mppt_recapture.status = SVC_CHARGE_MPPT_RECAPTURE_RESTARTING;
+    }
+}
+
+static void update_mppt_recapture_result(void)
+{
+    if(0U == g_charge_mppt_recapture_active)
+    {
+        return;
+    }
+    g_charge_mppt_recapture_elapsed_ticks++;
+    g_charge_mppt_recapture
+        .elapsed_ticks                  = g_charge_mppt_recapture_elapsed_ticks;
+    g_charge_mppt_recapture.state_after = g_charge_state;
+    g_charge_mppt_recapture.fault       = g_charge_fault;
+    if(SVC_CHARGE_STATE_FAULT == g_charge_state)
+    {
+        g_charge_mppt_recapture_active = 0U;
+        g_charge_mppt_recapture.status = SVC_CHARGE_MPPT_RECAPTURE_FAILED;
+    }
+    else if(SVC_CHARGE_STATE_CONSTANT_CURRENT == g_charge_state ||
+            SVC_CHARGE_STATE_CONSTANT_VOLTAGE == g_charge_state)
+    {
+        g_charge_mppt_recapture.settled_duty_permille = g_charge_duty_permille;
+        g_charge_mppt_recapture_active                = 0U;
+        g_charge_mppt_recapture.status = SVC_CHARGE_MPPT_RECAPTURE_DONE;
+    }
+    else if(g_charge_mppt_recapture_elapsed_ticks >=
+            delay_ms_to_ticks(SVC_CHARGE_MPPT_RECAPTURE_TIMEOUT_MS))
+    {
+        enter_fault(SVC_CHARGE_FAULT_SAMPLE_TIMEOUT, PLATFORM_ERR_TIMEOUT);
+        g_charge_mppt_recapture.state_after = g_charge_state;
+        g_charge_mppt_recapture.fault       = g_charge_fault;
+        g_charge_mppt_recapture_active      = 0U;
+        g_charge_mppt_recapture.status      = SVC_CHARGE_MPPT_RECAPTURE_FAILED;
+    }
+}
