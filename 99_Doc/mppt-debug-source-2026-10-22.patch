diff --git a/.agents/scripts/test-mppt-trend.ps1 b/.agents/scripts/test-mppt-trend.ps1
new file mode 100644
--- /dev/null
+++ b/.agents/scripts/test-mppt-trend.ps1
@@ -0,0 +1,366 @@
+param(
+    [string]$Gcc = 'D:\software_config\mingw64\mingw64\bin\gcc.exe'
+)
+
+$ErrorActionPreference = 'Stop'
+if (-not (Test-Path -LiteralPath $Gcc)) {
+    throw "Host compiler unavailable: $Gcc"
+}
+$repoRoot = (Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$testDirectory = Join-Path ([IO.Path]::GetTempPath()) ('mppt-trend-' + [guid]::NewGuid())
+New-Item -ItemType Directory -Path $testDirectory | Out-Null
+$harness = @'
+#include <assert.h>
+#include <stdio.h>
+
+#ifndef SVC_CHARGE_MPPT_DUTY_UP_STEP_PERMILLE
+#define SVC_CHARGE_MPPT_DUTY_UP_STEP_PERMILLE SVC_CHARGE_MPPT_DUTY_STEP_PERMILLE
+#define SVC_CHARGE_MPPT_DUTY_DOWN_STEP_PERMILLE SVC_CHARGE_MPPT_DUTY_STEP_PERMILLE
+#endif
+
+static svc_measure_value_t g_test_value;
+static uint16_t g_test_duty;
+
+static void start_test(uint16_t duty, uint32_t voltage, uint32_t current)
+{
+    svc_charge_mppt_reset();
+    svc_charge_mppt_trace_clear();
+    g_test_duty = duty;
+    g_test_value.battery_voltage_mv = voltage;
+    g_test_value.input_voltage_mv = 18000U;
+    g_test_value.input_current_ma = current;
+}
+
+static void window(uint32_t current)
+{
+    svc_charge_mppt_result_t result;
+    unsigned int i;
+    g_test_value.input_current_ma = current;
+    for(i = 0U; i < 50U; i++)
+    {
+        assert(PLATFORM_ERR_OK == svc_charge_mppt_update(
+            &g_test_value, g_test_duty, &result));
+        assert(result.duty_permille >= 150U);
+        assert(result.duty_permille <= 950U);
+        if(i < 49U)
+        {
+            assert(0U == result.duty_changed);
+        }
+        g_test_duty = result.duty_permille;
+    }
+}
+
+int main(void)
+{
+    svc_charge_mppt_result_t result;
+    uint32_t i;
+    uint32_t saved_sequence;
+    uint16_t saved_index;
+
+    /* Identical decreasing synthetic measurements on old and new source. */
+    start_test(842U, 14000U, 2000U);
+    window(2000U);
+    window(1996U);
+    assert(0 == g_charge_mppt_power_change);
+    window(1992U);
+#if MPPT_TREND_TEST
+    assert(-1 == g_charge_mppt_power_change);
+    assert(0U == g_charge_mppt_direction_increase);
+    assert(1U == g_charge_mppt_trace[1U].trend_reversed);
+    assert(28000000U == g_charge_mppt_trace[1U].trend_reference_power_uw);
+    assert(2U == g_charge_mppt_trace[1U].trend_compare_count);
+    assert(g_test_duty == g_charge_mppt_trace[1U].next_duty_requested_permille);
+    assert(0U == g_charge_mppt_trend_compare_count);
+#else
+    assert(0 == g_charge_mppt_power_change);
+    assert(1U == g_charge_mppt_direction_increase);
+#endif
+    printf("cumulative loss: direction=%u change=%d D=%u\n",
+        g_charge_mppt_direction_increase, g_charge_mppt_power_change,
+        g_test_duty);
+
+    /* Both original perturbation directions: significant gain/loss. */
+    for(i = 0U; i < 2U; i++)
+    {
+        start_test(800U, 14000U, 2000U);
+        g_charge_mppt_direction_increase = (uint8_t)i;
+        window(2000U);
+        window(2010U);
+        assert(1 == g_charge_mppt_power_change);
+        assert(i == g_charge_mppt_direction_increase);
+        window(2000U);
+        assert(-1 == g_charge_mppt_power_change);
+        assert((1U - i) == g_charge_mppt_direction_increase);
+    }
+
+#if MPPT_TREND_TEST
+    /* Symmetric cumulative decline while decreasing D. */
+    start_test(800U, 14000U, 2000U);
+    g_charge_mppt_direction_increase = 0U;
+    window(2000U);
+    window(1996U);
+    window(1992U);
+    assert(1U == g_charge_mppt_direction_increase);
+    assert(1U == g_charge_mppt_trace[1U].trend_reversed);
+
+    /* Exactly 0.1 W retains direction; cumulative >0.1 W reverses. */
+    start_test(800U, 10000U, 2000U);
+    window(2000U);
+    window(1990U);
+    assert(0 == g_charge_mppt_power_change);
+    window(1989U);
+    assert(-1 == g_charge_mppt_power_change);
+
+    /* Reference expires after eight comparisons, even with small drift. */
+    start_test(800U, 10000U, 2000U);
+    window(2000U);
+    for(i = 1U; i <= 9U; i++)
+    {
+        window(2000U - i);
+        assert(0 == g_charge_mppt_power_change);
+    }
+    assert(19920000U == g_charge_mppt_trace[8U].trend_reference_power_uw);
+    assert(1U == g_charge_mppt_trace[8U].trend_compare_count);
+
+    /* Follow a same-direction peak, not only the initial reference. */
+    start_test(800U, 10000U, 2000U);
+    window(2000U);
+    window(2006U);
+    window(2002U);
+    window(1998U);
+    window(1994U);
+    assert(1U == g_charge_mppt_trace[3U].trend_reversed);
+
+    /* pause/reset and unexpected actual D discard the old trend. */
+    svc_charge_mppt_pause(g_test_duty);
+    assert(0U == g_charge_mppt_trend_reference_power_uw);
+    window(1800U);
+    assert(18000000U == g_charge_mppt_trend_reference_power_uw);
+    g_test_duty += 5U;
+    window(1700U);
+    assert(17000000U == g_charge_mppt_trend_reference_power_uw);
+
+    /* One-shot A / B early / B late / A, with no tracking decisions. */
+    for(i = 1U; i <= 2U; i++)
+    {
+        start_test(832U, 14000U, 2000U);
+        g_charge_mppt_probe_request = (uint8_t)i;
+        window(2000U);
+        assert(SVC_CHARGE_MPPT_PROBE_RUNNING == g_charge_mppt_probe.status);
+        assert(1U == g_charge_mppt_probe.completed_points);
+        assert((1U == i ? 831U : 833U) == g_test_duty);
+        window(1980U);
+        assert((1U == i ? 831U : 833U) == g_test_duty);
+        assert(2U == g_charge_mppt_probe.completed_points);
+        window(1980U);
+        assert(832U == g_test_duty);
+        window(2000U);
+        assert(832U == g_test_duty);
+        assert(SVC_CHARGE_MPPT_PROBE_DONE == g_charge_mppt_probe.status);
+        assert(4U == g_charge_mppt_probe.completed_points);
+        assert(-280000 == g_charge_mppt_probe.delta_early_uw);
+        assert(-280000 == g_charge_mppt_probe.delta_late_uw);
+        assert(18000U == g_charge_mppt_probe.b_late.input_voltage_mv);
+        assert(1980U == g_charge_mppt_probe.b_late.input_current_ma);
+        assert(0U == g_charge_mppt_compare_count);
+        assert(0U == g_charge_mppt_trace_count);
+        window(2000U);
+        assert((832U + SVC_CHARGE_MPPT_DUTY_UP_STEP_PERMILLE) == g_test_duty);
+        /* Fresh normal baseline, not a compare. */
+        assert(0U == g_charge_mppt_compare_count);
+        window(2000U);
+        assert(1U == g_charge_mppt_compare_count);
+        svc_charge_mppt_reset();
+        assert(SVC_CHARGE_MPPT_PROBE_DONE == g_charge_mppt_probe.status);
+    }
+
+    /* A transient B loss recovers when the unchanged trial D is held longer. */
+    start_test(832U, 14000U, 2000U);
+    g_charge_mppt_probe_request = 1U;
+    window(2000U);
+    window(1980U);
+    window(2000U);
+    window(2000U);
+    assert(-280000 == g_charge_mppt_probe.delta_early_uw);
+    assert(0 == g_charge_mppt_probe.delta_late_uw);
+
+    /* Equal linear environmental drift cancels, without a fabricated gain. */
+    start_test(832U, 14000U, 2000U);
+    g_charge_mppt_probe_request = 1U;
+    window(2000U);
+    window(2010U);
+    window(2020U);
+    window(2030U);
+    assert(0 == g_charge_mppt_probe.delta_early_uw);
+    assert(0 == g_charge_mppt_probe.delta_late_uw);
+
+    /* Frozen ring does not suppress the independent probe snapshot. */
+    start_test(832U, 14000U, 2000U);
+    g_charge_mppt_trace_freeze = SVC_CHARGE_MPPT_TRACE_STOP;
+    g_charge_mppt_probe_request = 1U;
+    window(2000U);
+    g_charge_mppt_probe_request = 2U; /* Busy request cannot extend the run. */
+    window(2000U);
+    window(2000U);
+    window(2000U);
+    assert(SVC_CHARGE_MPPT_PROBE_DONE == g_charge_mppt_probe.status);
+    assert(0U == g_charge_mppt_probe_request);
+
+    /* Abort at every phase on CC pause, reset, and unexpected actual D.
+     * Never force a stale return-to-A proposal after another owner takes D. */
+    for(i = 0U; i < 4U; i++)
+    {
+        unsigned int j;
+        start_test(832U, 14000U, 2000U);
+        g_charge_mppt_probe_request = 1U;
+        assert(PLATFORM_ERR_OK == svc_charge_mppt_update(
+            &g_test_value, g_test_duty, &result));
+        for(j = 0U; j < i * 50U; j++)
+        {
+            assert(PLATFORM_ERR_OK == svc_charge_mppt_update(
+                &g_test_value, g_test_duty, &result));
+            g_test_duty = result.duty_permille;
+        }
+        svc_charge_mppt_pause(g_test_duty);
+        assert(SVC_CHARGE_MPPT_PROBE_ABORTED == g_charge_mppt_probe.status);
+        assert(0U == g_charge_mppt_probe_phase);
+        g_charge_mppt_probe_request = 1U;
+        svc_charge_mppt_reset();
+        assert(0U == g_charge_mppt_probe_request);
+    }
+    start_test(832U, 14000U, 2000U);
+    g_charge_mppt_probe_request = 1U;
+    window(2000U);
+    g_test_duty = 810U;
+    assert(PLATFORM_ERR_OK == svc_charge_mppt_update(
+        &g_test_value, g_test_duty, &result));
+    assert(SVC_CHARGE_MPPT_PROBE_ABORTED == g_charge_mppt_probe.status);
+    assert(810U == result.duty_permille);
+    assert(0U == result.duty_changed);
+
+    /* Invalid direction and out-of-range one-step requests are rejected. */
+    for(i = 1U; i <= 3U; i++)
+    {
+        start_test(1U == i ? 150U : 950U, 14000U, 2000U);
+        g_charge_mppt_probe_request = (uint8_t)i;
+        assert(PLATFORM_ERR_OK == svc_charge_mppt_update(
+            &g_test_value, g_test_duty, &result));
+        assert(SVC_CHARGE_MPPT_PROBE_REJECTED == g_charge_mppt_probe.status);
+        assert(0U == result.duty_changed);
+    }
+
+    /* Interpolation cannot overflow even at UINT32_MAX averaged power. */
+    start_test(832U, UINT32_MAX, 1U);
+    g_test_value.input_voltage_mv = UINT32_MAX;
+    g_charge_mppt_probe_request = 1U;
+    window(1U);
+    window(1U);
+    window(1U);
+    window(1U);
+    assert(UINT32_MAX == g_charge_mppt_probe.reference_early_uw);
+    assert(UINT32_MAX == g_charge_mppt_probe.b_late.input_voltage_mv);
+    assert(0 == g_charge_mppt_probe.delta_late_uw);
+    puts("PASS: one-step probe, transient/drift, aborts, frozen ring, overflow");
+#endif
+
+    /* Freeze preserves history while the tracker continues running. */
+    start_test(800U, 14000U, 2000U);
+    window(2000U);
+    window(2000U);
+    saved_index = g_charge_mppt_trace_write_index;
+    saved_sequence = g_charge_mppt_trace_sequence;
+    svc_charge_mppt_trace_freeze(SVC_CHARGE_MPPT_TRACE_STOP);
+    window(1600U);
+    assert(saved_index == g_charge_mppt_trace_write_index);
+    assert(saved_sequence == g_charge_mppt_trace_sequence);
+    svc_charge_mppt_reset();
+    assert(saved_sequence == g_charge_mppt_trace_sequence);
+    svc_charge_mppt_trace_clear();
+    assert(0U == g_charge_mppt_trace_count);
+
+    /* Long plateau crosses both physical bounds and wraps the trace. */
+    start_test(949U, 14000U, 2000U);
+    window(2000U);
+    assert(950U == g_test_duty);
+    window(2000U);
+    assert((950U - SVC_CHARGE_MPPT_DUTY_DOWN_STEP_PERMILLE) == g_test_duty);
+    for(i = 0U; i < 2000U; i++)
+    {
+        window(2000U);
+#if MPPT_TREND_TEST
+        assert(g_charge_mppt_trend_compare_count < 8U);
+        assert(0U == g_charge_mppt_trend_reversed);
+#endif
+    }
+    assert(32U == g_charge_mppt_trace_count);
+    assert(g_charge_mppt_trace_write_index < 32U);
+    /* Every valid starting D and both directions, including odd parity near
+     * limits: upward and downward steps use independent expected sizes. */
+    for(i = 150U; i <= 950U; i++)
+    {
+        unsigned int direction;
+        for(direction = 0U; direction < 2U; direction++)
+        {
+            unsigned int expected;
+            start_test((uint16_t)i, 14000U, 2000U);
+            g_charge_mppt_direction_increase = (uint8_t)direction;
+            if(150U == i)
+            {
+                expected = i + SVC_CHARGE_MPPT_DUTY_UP_STEP_PERMILLE;
+            }
+            else if(950U == i)
+            {
+                expected = i - SVC_CHARGE_MPPT_DUTY_DOWN_STEP_PERMILLE;
+            }
+            else if(0U != direction)
+            {
+                expected = i + SVC_CHARGE_MPPT_DUTY_UP_STEP_PERMILLE;
+                if(expected > 950U) { expected = 950U; }
+            }
+            else
+            {
+                expected = i - SVC_CHARGE_MPPT_DUTY_DOWN_STEP_PERMILLE;
+                if(expected < 150U) { expected = 150U; }
+            }
+            window(2000U);
+            assert(expected == g_test_duty);
+        }
+    }
+    printf("PASS: every valid D, tracking step=+%u/-%u permille\n",
+        SVC_CHARGE_MPPT_DUTY_UP_STEP_PERMILLE,
+        SVC_CHARGE_MPPT_DUTY_DOWN_STEP_PERMILLE);
+    assert(PLATFORM_ERR_PARAM == svc_charge_mppt_update(
+        NULL, 800U, &result));
+    assert(PLATFORM_ERR_PARAM == svc_charge_mppt_update(
+        &g_test_value, 149U, &result));
+    assert(PLATFORM_ERR_PARAM == svc_charge_mppt_update(
+        &g_test_value, 951U, &result));
+    puts("PASS: direction, timing, trend lifecycle, trace, bounds, parameters");
+    return 0;
+}
+'@
+
+Push-Location $repoRoot
+try {
+    foreach ($variant in @('baseline', 'working')) {
+        if ($variant -eq 'baseline') {
+            $module = (& git show '836b930af275a6a42c77202b11797d24ac7a6364:02_Service/svc_charge_mppt.c') -join "`n"
+            if ($LASTEXITCODE -ne 0) { throw 'Cannot read baseline source' }
+            $enabled = 0
+        } else {
+            $module = Get-Content -Raw -LiteralPath '02_Service/svc_charge_mppt.c'
+            $enabled = 1
+        }
+        $executable = Join-Path $testDirectory "$variant.exe"
+        ($module + "`n" + $harness) | & $Gcc -x c -std=c99 -Wall -Wextra -Werror `
+            "-DMPPT_TREND_TEST=$enabled" -I02_Service -I03_Platform/bsp `
+            -I03_Platform/comm -I03_Platform/mcu_interface -o $executable -
+        if ($LASTEXITCODE -ne 0) { throw "$variant compile failed" }
+        Write-Output "--- $variant ---"
+        & $executable
+        if ($LASTEXITCODE -ne 0) { throw "$variant assertions failed" }
+    }
+    Write-Output "Host executables retained at $testDirectory"
+} finally {
+    Pop-Location
+}

diff --git a/.agents/scripts/test-mppt-recapture.ps1 b/.agents/scripts/test-mppt-recapture.ps1
new file mode 100644
--- /dev/null
+++ b/.agents/scripts/test-mppt-recapture.ps1
@@ -0,0 +1,235 @@
+param([string]$Gcc = 'D:\software_config\mingw64\mingw64\bin\gcc.exe')
+
+$ErrorActionPreference = 'Stop'
+if (-not (Test-Path -LiteralPath $Gcc)) { throw "Compiler unavailable: $Gcc" }
+$repoRoot = (Resolve-Path (Join-Path $PSScriptRoot '../..')).Path
+$testDirectory = Join-Path ([IO.Path]::GetTempPath()) ('mppt-recapture-' + [guid]::NewGuid())
+New-Item -ItemType Directory -Path $testDirectory | Out-Null
+$source = @'
+#include <assert.h>
+#include <stdio.h>
+#include "svc_charge.c"
+
+static uint8_t g_test_pwm_on;
+static uint8_t g_test_ready = 1U;
+static uint32_t g_test_sequence;
+static uint32_t g_test_start_count;
+static uint32_t g_test_stop_count;
+static uint32_t g_test_set_count;
+static uint32_t g_test_off_vin = 18000U;
+static uint32_t g_test_on_vin = 16900U;
+static uint32_t g_test_battery = 13700U;
+static int16_t g_test_temperature = 250;
+static platform_err_t g_test_stop_status = PLATFORM_ERR_OK;
+static platform_err_t g_test_start_status = PLATFORM_ERR_OK;
+static uint16_t g_test_initial_duty;
+
+platform_err_t svc_measure_get(svc_measure_value_t *p_value)
+{
+    assert(NULL != p_value);
+    memset(p_value, 0, sizeof(*p_value));
+    p_value->input_voltage_mv = g_test_pwm_on ? g_test_on_vin : g_test_off_vin;
+    p_value->battery_voltage_mv = g_test_battery;
+    p_value->input_current_ma = g_test_pwm_on ? 2700U : 0U;
+    p_value->output_current_ma = 10U;
+    p_value->battery_current_ma = (int32_t)p_value->input_current_ma - 10;
+    p_value->temperature_deci_c = g_test_temperature;
+    return PLATFORM_ERR_OK;
+}
+uint32_t svc_measure_get_sequence(void) { return g_test_sequence; }
+uint8_t svc_measure_is_ready(void) { return g_test_ready; }
+
+platform_err_t bsp_power_path_charge_stop(void)
+{
+    g_test_stop_count++;
+    if(PLATFORM_ERR_OK == g_test_stop_status) { g_test_pwm_on = 0U; }
+    return g_test_stop_status;
+}
+platform_err_t bsp_power_path_charge_start(uint16_t duty)
+{
+    g_test_start_count++;
+    g_test_initial_duty = duty;
+    if(PLATFORM_ERR_OK == g_test_start_status) { g_test_pwm_on = 1U; }
+    return g_test_start_status;
+}
+platform_err_t bsp_power_path_charge_set_duty(uint16_t duty)
+{
+    assert(g_test_pwm_on);
+    assert(duty >= 150U && duty <= 950U);
+    g_test_set_count++;
+    return PLATFORM_ERR_OK;
+}
+
+static void tick(void)
+{
+    g_test_sequence += 10U;
+    svc_charge_process();
+}
+static void begin_test(void)
+{
+    unsigned int i;
+    g_test_stop_status = PLATFORM_ERR_OK;
+    g_test_start_status = PLATFORM_ERR_OK;
+    g_test_temperature = 250;
+    g_test_battery = 13700U;
+    g_test_off_vin = 18000U;
+    g_test_on_vin = 16900U;
+    g_test_ready = 1U;
+    assert(PLATFORM_ERR_OK == svc_charge_init(SVC_CHARGE_BATTERY_SYSTEM_12V));
+    assert(PLATFORM_ERR_OK == svc_charge_start());
+    for(i = 0U; i < 4U; i++) { tick(); }
+    assert(SVC_CHARGE_STATE_CONSTANT_CURRENT == g_charge_state);
+    assert(0U == g_charge_current_limited);
+    g_charge_duty_permille = 828U;
+    g_test_start_count = 0U;
+    g_test_stop_count = 0U;
+    g_test_set_count = 0U;
+}
+
+int main(void)
+{
+    unsigned int i;
+    uint32_t starts;
+    uint32_t stops;
+    svc_charge_state_t states[] = {
+        SVC_CHARGE_STATE_OFF, SVC_CHARGE_STATE_WAIT_SAMPLE,
+        SVC_CHARGE_STATE_START_SETTLE, SVC_CHARGE_STATE_WAKE_CV,
+        SVC_CHARGE_STATE_CONSTANT_VOLTAGE, SVC_CHARGE_STATE_FAULT,
+        SVC_CHARGE_STATE_FULL_WAIT, SVC_CHARGE_STATE_MAINTENANCE
+    };
+
+    begin_test();
+    g_charge_mppt_recapture_request = 1U;
+    tick();
+    assert(SVC_CHARGE_STATE_MPPT_RECAPTURE_WAIT == g_charge_state);
+    assert(0U == g_charge_mppt_recapture_request);
+    assert(0U == g_test_pwm_on);
+    assert(0U == g_charge_duty_permille);
+    assert(828U == g_charge_mppt_recapture.duty_before_permille);
+    assert(16900U == g_charge_mppt_recapture.input_voltage_before_mv);
+    assert(1U == g_test_stop_count);
+    for(i = 0U; i < 49U; i++)
+    {
+        tick();
+        assert(0U == g_test_start_count);
+        assert(0U == g_test_set_count);
+        assert(0U == g_test_pwm_on);
+    }
+    g_charge_mppt_recapture_request = 1U; /* Busy must not extend the wait. */
+    tick();
+    assert(SVC_CHARGE_STATE_WAIT_SAMPLE == g_charge_state);
+    assert(0U == g_test_start_count);
+    tick();
+    assert(1U == g_test_start_count);
+    assert(761U == g_test_initial_duty);
+    assert(761U == g_charge_mppt_recapture.initial_duty_permille);
+    assert(18000U == g_charge_mppt_recapture.input_voltage_restart_mv);
+    assert(0U == g_charge_mppt_recapture.input_current_restart_ma);
+    tick();
+    tick();
+    assert(SVC_CHARGE_MPPT_RECAPTURE_DONE == g_charge_mppt_recapture.status);
+    assert(811U == g_charge_mppt_recapture.settled_duty_permille);
+    assert(SVC_CHARGE_STATE_CONSTANT_CURRENT == g_charge_mppt_recapture.state_after);
+    starts = g_test_start_count;
+    stops = g_test_stop_count;
+    for(i = 0U; i < 100U; i++) { tick(); }
+    assert(starts == g_test_start_count);
+    assert(stops == g_test_stop_count);
+    puts("PASS: confirmed PWM off, fresh 500 ms wait, recomputed D, no repeat");
+
+    /* Admission guard tested without running unrelated state handlers. */
+    for(i = 0U; i < sizeof(states) / sizeof(states[0U]); i++)
+    {
+        begin_test();
+        g_charge_state = states[i];
+        g_charge_mppt_recapture_request = 1U;
+        request_mppt_recapture();
+        assert(SVC_CHARGE_MPPT_RECAPTURE_REJECTED == g_charge_mppt_recapture.status);
+        assert(0U == g_test_stop_count);
+        assert(states[i] == g_charge_state);
+    }
+    begin_test();
+    g_charge_current_limited = 1U;
+    g_charge_mppt_recapture_request = 1U;
+    request_mppt_recapture();
+    assert(SVC_CHARGE_MPPT_RECAPTURE_REJECTED == g_charge_mppt_recapture.status);
+    assert(0U == g_test_stop_count);
+    begin_test();
+    g_charge_mppt_probe.status = SVC_CHARGE_MPPT_PROBE_RUNNING;
+    g_charge_mppt_recapture_request = 1U;
+    request_mppt_recapture();
+    assert(SVC_CHARGE_MPPT_RECAPTURE_REJECTED == g_charge_mppt_recapture.status);
+    g_charge_mppt_probe.status = SVC_CHARGE_MPPT_PROBE_IDLE;
+
+    begin_test();
+    g_test_stop_status = PLATFORM_ERR_HW;
+    g_charge_mppt_recapture_request = 1U;
+    tick();
+    for(i = 0U; i < 60U; i++) { tick(); }
+    assert(0U == g_test_start_count);
+    assert(SVC_CHARGE_STATE_FAULT == g_charge_state);
+    assert(SVC_CHARGE_MPPT_RECAPTURE_FAILED == g_charge_mppt_recapture.status);
+    assert(g_test_stop_count > 1U); /* Existing fault path retries stop. */
+
+    begin_test();
+    g_charge_mppt_recapture_request = 1U;
+    tick();
+    svc_charge_process(); /* Same sequence: one missed fresh measurement. */
+    svc_charge_process(); /* Original 20 ms sample timeout. */
+    assert(SVC_CHARGE_MPPT_RECAPTURE_FAILED == g_charge_mppt_recapture.status);
+    assert(SVC_CHARGE_FAULT_SAMPLE_TIMEOUT == g_charge_fault);
+    assert(0U == g_test_start_count);
+
+    begin_test();
+    g_charge_mppt_recapture_request = 1U;
+    tick();
+    g_test_start_status = PLATFORM_ERR_HW;
+    for(i = 0U; i < 54U; i++) { tick(); }
+    assert(SVC_CHARGE_MPPT_RECAPTURE_FAILED == g_charge_mppt_recapture.status);
+    assert(0U == g_test_pwm_on);
+
+    begin_test();
+    g_charge_mppt_recapture_request = 1U;
+    tick();
+    assert(PLATFORM_ERR_OK == svc_charge_stop());
+    for(i = 0U; i < 100U; i++) { tick(); }
+    assert(SVC_CHARGE_STATE_OFF == g_charge_state);
+    assert(SVC_CHARGE_MPPT_RECAPTURE_ABORTED == g_charge_mppt_recapture.status);
+    assert(0U == g_test_start_count);
+
+    begin_test();
+    g_charge_mppt_recapture_request = 1U;
+    tick();
+    g_test_ready = 0U;
+    for(i = 0U; i < 500U; i++) { tick(); }
+    assert(SVC_CHARGE_MPPT_RECAPTURE_FAILED == g_charge_mppt_recapture.status);
+    assert(0U == g_test_start_count);
+
+    begin_test();
+    g_charge_mppt_recapture_request = 1U;
+    tick();
+    g_test_off_vin = 13000U;
+    tick();
+    assert(SVC_CHARGE_STATE_FAULT == g_charge_state);
+    assert(SVC_CHARGE_MPPT_RECAPTURE_FAILED == g_charge_mppt_recapture.status);
+    assert(0U == g_test_start_count);
+    puts("PASS: admission, busy, stop/start failure, timeout, cancel, input fault");
+    return 0;
+}
+'@
+
+Push-Location $repoRoot
+try {
+    $executable = Join-Path $testDirectory 'recapture.exe'
+    $source | & $Gcc -x c -std=c99 -Wall -Wextra -Werror `
+        -I02_Service -I03_Platform/bsp -I03_Platform/comm -I03_Platform/mcu_interface `
+        -o $executable - 02_Service/svc_charge_config.c 02_Service/svc_charge_control.c `
+        02_Service/svc_charge_maintenance.c 02_Service/svc_charge_protection.c `
+        02_Service/svc_charge_mppt.c
+    if ($LASTEXITCODE -ne 0) { throw 'Recapture host compile failed' }
+    & $executable
+    if ($LASTEXITCODE -ne 0) { throw 'Recapture assertions failed' }
+    Write-Output "Host executable retained at $testDirectory"
+} finally {
+    Pop-Location
+}
