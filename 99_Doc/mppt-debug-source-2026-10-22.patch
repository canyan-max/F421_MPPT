+static void abort_probe(void)
+{
+    g_charge_mppt_probe_request = 0U;
+    if(0U != g_charge_mppt_probe_phase)
+    {
+        g_charge_mppt_probe_phase  = 0U;
+        g_charge_mppt_probe.status = SVC_CHARGE_MPPT_PROBE_ABORTED;
+    }
+}
+
+static void restart_probe_window(void)
+{
+    restart_window();
+    g_charge_mppt_probe_voltage_sum_mv = 0U;
+    g_charge_mppt_probe_battery_sum_mv = 0U;
+    g_charge_mppt_probe_current_sum_ma = 0U;
+}
+
+static void start_probe(uint16_t current_duty_permille)
+{
+    static const svc_charge_mppt_probe_t g_empty_probe =
+        {SVC_CHARGE_MPPT_PROBE_IDLE,
+         0U,
+         0U,
+         0U,
+         {0},
+         {0},
+         {0},
+         {0},
+         0U,
+         0U,
+         0,
+         0};
+    uint8_t request = g_charge_mppt_probe_request;
+
+    g_charge_mppt_probe_request = 0U;
+    g_charge_mppt_probe         = g_empty_probe;
+    if((1U != request && 2U != request) ||
+       (1U == request &&
+        current_duty_permille <= BSP_POWER_PATH_CHARGE_DUTY_MIN_PERMILLE) ||
+       (2U == request &&
+        current_duty_permille >= BSP_POWER_PATH_CHARGE_DUTY_MAX_PERMILLE))
+    {
+        g_charge_mppt_probe.status = SVC_CHARGE_MPPT_PROBE_REJECTED;
+        return;
+    }
+    invalidate_comparison(current_duty_permille);
+    g_charge_mppt_probe_origin_duty = current_duty_permille;
+    g_charge_mppt_probe_trial_duty =
+        (1U == request)
+            ? current_duty_permille - SVC_CHARGE_MPPT_PROBE_STEP_PERMILLE
+            : current_duty_permille + SVC_CHARGE_MPPT_PROBE_STEP_PERMILLE;
+    g_charge_mppt_probe.origin_duty_permille = g_charge_mppt_probe_origin_duty;
+    g_charge_mppt_probe.probe_duty_permille  = g_charge_mppt_probe_trial_duty;
+    g_charge_mppt_probe_phase                = 1U;
+    restart_probe_window();
+    g_charge_mppt_probe.status = SVC_CHARGE_MPPT_PROBE_RUNNING;
+}
+
+static void save_probe_window(svc_charge_mppt_result_t *p_result)
+{
+    svc_charge_mppt_probe_point_t point;
+    uint64_t                      power_before_uw;
+    uint64_t                      power_after_uw;
+
+    /* Called only after a complete, range-checked 200 ms power average. */
+    point.power_uw           = g_charge_mppt_power_raw;
+    point.input_voltage_mv   = (uint32_t)(g_charge_mppt_probe_voltage_sum_mv /
+                                          g_charge_mppt_sample_count);
+    point.battery_voltage_mv = (uint32_t)(g_charge_mppt_probe_battery_sum_mv /
+                                          g_charge_mppt_sample_count);
+    point.input_current_ma   = (uint32_t)(g_charge_mppt_probe_current_sum_ma /
+                                          g_charge_mppt_sample_count);
+    point.service_tick       = g_charge_mppt_trace_service_tick;
+    if(1U == g_charge_mppt_probe_phase)
+    {
+        g_charge_mppt_probe.a_before = point;
+        p_result->duty_permille      = g_charge_mppt_probe_trial_duty;
+    }
+    else if(2U == g_charge_mppt_probe_phase)
+    {
+        g_charge_mppt_probe.b_early = point;
+    }
+    else if(3U == g_charge_mppt_probe_phase)
+    {
+        g_charge_mppt_probe.b_late = point;
+        p_result->duty_permille    = g_charge_mppt_probe_origin_duty;
+    }
+    else
+    {
+        g_charge_mppt_probe.a_after = point;
+        /* Equal 500 ms windows: B samples lie 1/3 and 2/3 between A samples.
+         * Linear drift compensation is diagnostic, not proof of stationarity.
+         */
